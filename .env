# .env.example - пример переменных окружения

# Токен вашего Telegram-бота
BOT_TOKEN="7897850545:AAE273cSvEiG80VDc9-JGzXJLRLngeGzjvA"

# Настройки базы данных PostgreSQL
# (для локального запуска вне Docker используйте localhost,
#  в Docker Compose указывайте хост службы, например "db")
DB_HOST=db
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Настройки Redis (для FSM)
# (для локального запуска укажите localhost, в Docker Compose - "redis")
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Способ регистрации репетиторов:
# Либо список разрешённых Telegram ID, либо секретный код доступа.
ALLOWED_TUTOR_IDS=123   # пример ID через запятую
TUTOR_REG_CODE="260220"       # секретный код (если не используются ID)

ADMIN_ID=430082817

DATABASE_URL=postgresql+asyncpg://tutor:secret@db:5432/tutorbot
REDIS_URL=redis://redis:6379/0
